# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Generate a signing key (any 32+ byte random string):
#   openssl rand -base64 48

# Required. The API refuses to start without it.
JWT_SIGNING_KEY=

# Optional - the defaults below work for local development.
# POSTGRES_USER=innjourney
# POSTGRES_PASSWORD=innjourney
# POSTGRES_DB=inn_journey
# POSTGRES_PORT=5432

# JWT_ISSUER=inn-journey-api
# JWT_AUDIENCE=inn-journey-web

# API_PORT=8080
# WEB_PORT=4200
# WEB_ORIGIN=http://localhost:4200
# ASPNETCORE_ENVIRONMENT=Development

# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025

# Set to false to start with an empty database instead of demo data.
# SEED_ON_STARTUP=true
