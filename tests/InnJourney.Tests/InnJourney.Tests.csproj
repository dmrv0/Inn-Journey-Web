<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The app targets net8.0 (LTS); the test host targets the installed
         runtime so TestServer matches the System.Text.Json it runs against. -->
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- GHSA-2m69-gcr7-jv3q, GHSA-q939-rpr3-3284: test-only, unfixed upstream. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <!-- Kept current; both still carry open advisories with no patched release
         upstream. They are test-only transitive dependencies (SQLite via EF's
         test provider, SSH.NET via Testcontainers) and reach no shipped
         artefact, so the warnings are suppressed below rather than ignored. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InnJourney.Application\InnJourney.Application.csproj" />
    <ProjectReference Include="..\..\src\InnJourney.Domain\InnJourney.Domain.csproj" />
    <ProjectReference Include="..\..\src\InnJourney.Infra.Data\InnJourney.Infra.Data.csproj" />
    <ProjectReference Include="..\..\src\InnJourney.Services.Api\InnJourney.Services.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
