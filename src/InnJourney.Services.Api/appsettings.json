{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": ""
  },
  "Jwt": {
    "Issuer": "inn-journey-api",
    "Audience": "inn-journey-web",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Storage": {
    "RootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads",
    "MaxFileSizeBytes": 5242880
  },
  "Email": {
    "FromAddress": "no-reply@innjourney.dev",
    "FromName": "Inn Journey",
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "GlobalPermitsPerMinute": 300
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  }
}
